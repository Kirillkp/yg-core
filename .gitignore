[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
MemoryCaptures/
Recordings/

# Решения и кэши IDE
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.pidb
*.booproj

# Сборки и пакеты
*.apk
*.aab
