# Папка Documentation~ это соглашение Unity для документации пакета.
# Глобальный игнор с шаблоном *~ (резервные копии редакторов) исключил бы её,
# поэтому явно возвращаем её в репозиторий.
!Documentation~/

# Результаты сборки вспомогательных dotnet-проектов в Tools/
Tools/**/bin/
Tools/**/obj/

# Стенд: служебные журналы PluginYG2 (сам плагин коммитится: лицензия CC0).
/Stand/Assets/PluginYourGames/Editor/BuildLogYG2.txt
/Stand/Assets/PluginYourGames/Editor/BuildLogYG2.txt.meta

# Служебные файлы Unity в корне репозитория (корень открывали в Hub по ошибке, проект стенда лежит в Stand/).
/ProjectSettings/
/Assets/
/Assets.meta
/yg-core.slnx
/Packages/manifest.json
/Packages/packages-lock.json
